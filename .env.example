# Self-Evaluating Lesson Content Generator — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env to source control.

# ── Groq API ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Model Configuration ───────────────────────────────────────────────────────
# Available Groq instruction-tuned models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GENERATOR_MODEL=llama-3.3-70b-versatile
EVALUATOR_MODEL=llama-3.3-70b-versatile
GENERATOR_TEMPERATURE=0.7
EVALUATOR_TEMPERATURE=0.1
MODEL_MAX_TOKENS=4096
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=3

# ── FastAPI Application ───────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
# API key for protecting endpoints (clients send: X-API-Key: <value>)
API_KEY=your-api-key-here

# ── Database (SQLite for local dev — no server needed) ───────────────────────
# For production, switch to PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/lesson_db
DATABASE_URL=sqlite:///./lesson_generator.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis (optional — disabled by default) ────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── Input Limits ──────────────────────────────────────────────────────────────
MAX_TOPIC_LENGTH=500
MAX_REFERENCE_MATERIAL_LENGTH=50000
MAX_LEARNING_OBJECTIVES=10

# ── Workflow ──────────────────────────────────────────────────────────────────
DEFAULT_MAX_RETRIES=2
RUBRIC_VERSION=rag-beginner-v1
PROMPT_VERSION=v1

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=lesson-content-generator
METRICS_BEARER_TOKEN=your-metrics-token-here
