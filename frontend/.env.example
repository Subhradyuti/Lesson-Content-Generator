# API configuration for the Lesson Forge frontend.
# Copy to `.env` and adjust values for your environment. Never commit `.env`.
#
# Leave VITE_API_BASE_URL empty to talk to the same origin (the Vite dev server
# proxies /v1 and /health to the FastAPI backend — see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8000
#
# Optional X-API-Key sent on every request. The backend enforces this header
# when API_KEY is set in the backend .env. Leave empty if auth is disabled.
# VITE_API_KEY=your-api-key-here
